# =============================================================================
# EstudeVet v11 - variaveis de ambiente
#
# OPCIONAIS PARA RODAR O APP. A URL e a chave `anon` ja estao embutidas em
# src/lib/supabase/config.ts, porque sao publicas por natureza - vao para o
# navegador de qualquer jeito, e quem protege os dados e a RLS.
#
# Preencha aqui so se quiser apontar para OUTRO projeto Supabase (staging,
# um fork da turma). Quando existirem, estas variaveis vencem o valor
# embutido.
# =============================================================================

# NEXT_PUBLIC_SUPABASE_URL=https://outro-projeto.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# =============================================================================
# ESTA E SECRETA DE VERDADE
#
# A service_role passa POR CIMA da RLS. Nunca vai para o repositorio, nunca
# recebe prefixo NEXT_PUBLIC. So e necessaria para os scripts de migracao e
# importacao, que rodam na sua maquina - o app nao usa.
#
# Pegue em: Settings > API Keys > Legacy > service_role > Reveal
# =============================================================================

SUPABASE_SERVICE_ROLE_KEY=

# Opcional: so se os scripts precisarem apontar para outro projeto.
# Sem ela, eles usam a mesma URL embutida no app.
# SUPABASE_URL=https://outro-projeto.supabase.co

# --- Projeto ANTIGO (v10), so para migrar as questoes ------------------------
LEGADO_SUPABASE_URL=
LEGADO_SUPABASE_KEY=
